DOCKER_USERNAME=your-dockerhub-username

MYSQL_URL=jdbc:mysql://mysql-xxxxx.aivencloud.com:17584/university_db?sslMode=REQUIRED

MYSQL_USERNAME=avnadmin
MYSQL_PASSWORD=xxxxxxxxxxxx

REDIS_HOST=xxxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=xxxxxxxxxxxx

KAFKA_BOOTSTRAP=pkc-xxxxx.ap-south-1.aws.confluent.cloud:9092
KAFKA_USERNAME=xxxxxxxx
KAFKA_PASSWORD=xxxxxxxx
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.plain.PlainLoginModule required username="xxxxxxxx" password="xxxxxxxx";
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN

AUTH_SERVICE_URL=your_vm_ip
USER_SERVICE_URL=your_vm_ip
CONTENT_SERVICE_URL=your_vm_ip