[TEMPLATE]
DOCKER_USERNAME=your-dockerhub-username

# Domain that points to this VM - nginx-proxy terminates HTTPS for it
VIRTUAL_HOST=api.prevpaper.fun

# Email used by Let's Encrypt for certificate registration/renewal warnings
LETSENCRYPT_EMAIL=your-email@example.com


AUTH_SERVICE_URL=your_vm_ip_or_url
USER_SERVICE_URL=your_vm_ip_or_url
CONTENT_SERVICE_URL=your_vm_ip_or_url
UNIVERSITY_SERVICE_URL=your_vm_ip_or_url
NOTIFICATION_SERVICE_URL=your_vm_ip_or_url
UPLOAD_SERVICE_URL=your_vm_ip_or_url
